{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "description": "ツール導入 step の VERSION と SHA256 を更新する（SHA256 は release アセットの digest から算出される）。VERSION は引用符付きでも取れる。tag が v 始まりのツール用",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)\\s+(?:[A-Z0-9_]+_)?VERSION:\\s*\"?(?<currentValue>[^\\s\"]+)\"?\\s+(?:[A-Z0-9_]+_)?SHA256:\\s*(?<currentDigest>\\S+)"
      ],
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Python ツール導入 step の <TOOL>_VERSION を PyPI の最新版に更新する（datasource=pypi のブロックのみ対象、SHA256 は無い）",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=pypi depName=(?<depName>[^\\s]+?)\\s+[A-Z_]+_VERSION:\\s*\"?(?<currentValue>[^\\s\"]+)\"?"
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ],
  "packageRules": [
    {
      "description": "Bun のリリースタグは bun-v プレフィックス付きのためバージョン抽出を上書きする",
      "matchPackageNames": ["oven-sh/bun"],
      "extractVersion": "^bun-v(?<version>.*)$"
    }
  ]
}
